              "id": "one method function",
              "md": "one method function"
            },
            {
              "id": "a private copy each",
              "md": "a private copy each"
            },
            {
              "id": "no methods",
              "md": "no methods"
            }
          ]
        }
      ],
      "answer": {
        "a": "one method function"
      },
      "explainMd": "The method lives once on the prototype. Instances look it up; they do not each get a copy."
    },
