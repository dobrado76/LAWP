        {
          "id": "east",
          "md": "east — it still sees `dir`"
        },
        {
          "id": "lost",
          "md": "nowhere — `dir` is gone",
          "misconceptionId": "closure-copies-value"
        }
      ],
      "answer": "east"
    },
