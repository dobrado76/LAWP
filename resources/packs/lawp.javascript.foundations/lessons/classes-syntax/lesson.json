  "blocks": [
    {
      "type": "explain",
      "md": "## A route blueprint\n\n`class Route { constructor(dir) { this.dir = dir } go() { Player.move(this.dir) } }` is nicer spelling for prototype methods. The fox uses `new Route(\"east\").go()` three times."
    },
    {
      "type": "predict",
      "id": "class-proto",
      "promptMd": "`new Route(\"east\").go === new Route(\"east\").go` is…",
      "kind": "mcq",
      "choices": [
        {
          "id": "false",
          "md": "false — each instance gets a new go"
        },
        {
          "id": "true",
          "md": "true — go lives on Route.prototype"
        }
      ],
      "answer": "true"
    },
