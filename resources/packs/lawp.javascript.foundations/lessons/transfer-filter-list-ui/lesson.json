      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "for (const li of list.querySelectorAll(\"li\")) li.hidden = !li.textContent.toLowerCase().includes(q)"
        },
        {
          "level": 4,
          "kind": "assist",
          "md": "const q = document.querySelector(\"#q\")\nq.addEventListener(\"input\", () => {\n  const needle = q.value.toLowerCase()\n  for (const li of document.querySelectorAll(\"#list li\")) {\n    li.hidden = !li.textContent.toLowerCase().includes(needle)\n  }\n})"
        }
      ]
