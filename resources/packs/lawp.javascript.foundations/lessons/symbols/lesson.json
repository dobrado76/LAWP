        }
      ],
      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "Make a `Symbol`, then use it as a key."
        },
        {
          "level": 2,
          "kind": "concept",
          "md": "Store `\"note\"` at `obj[k]`. Read it back the same way."
        },
        {
          "level": 3,
          "kind": "concept",
          "md": "const k = Symbol(\"meta\"); obj[k] = \"note\""
        },
        {
          "level": 4,
          "kind": "assist",
          "md": "const k = Symbol(\"meta\")\nconst obj = { [k]: \"note\" }\nfunction hiddenNote() { return obj[k] }\nconsole.log(hiddenNote())\nmodule.exports = { hiddenNote, k, obj }"
        }
      ]
    }
  ],
  "description": "A unique key that will not clash with ordinary names."
}
