  "blocks": [
    {
      "type": "explain",
      "md": "## `===` does not convert\n\n`0 == \"\"` is true because `==` coerces. `0 === \"\"` is false. Print whether they are **not** strictly equal (true)."
    },
    {
      "type": "code",
      "id": "strict",
      "engine": "javascript",
      "entry": "main.js",
      "files": [{ "path": "files/main.js", "role": "edit" }],
      "checks": [
        { "type": "stdout", "equals": "true", "misconceptionId": "double-equals-ok" },
        { "type": "ast", "query": "===" }
      ],
      "hintLadder": [
        { "level": 1, "kind": "concept", "md": "Use ===, then negate or compare to false." },
        { "level": 2, "kind": "concept", "md": "console.log(0 === \"\" ? false : true) or console.log(!(0 === \"\")) wait — you want true because they are not equal: console.log(0 !== \"\")" }
      ]
    }
  ]
}
