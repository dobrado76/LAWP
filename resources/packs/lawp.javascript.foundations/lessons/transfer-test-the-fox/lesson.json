      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "east +x, west -x, south +y, north -y."
        },
        {
          "level": 4,
          "kind": "assist",
          "md": "function walk(dirs) {\n  let x = 0, y = 0\n  for (const d of dirs) {\n    if (d === \"east\") x += 1\n    if (d === \"west\") x -= 1\n    if (d === \"south\") y += 1\n    if (d === \"north\") y -= 1\n  }\n  return { x, y }\n}\nconst p = walk([\"east\", \"east\", \"east\", \"south\", \"south\"])\nconsole.log(p.x + \",\" + p.y)\nmodule.exports = { walk }"
        }
