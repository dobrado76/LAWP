          "type": "js-assert"
        }
      ],
      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "Put the move and the rotate on the same object under names."
        },
        {
          "level": 2,
          "kind": "concept",
          "md": "`go` should call `Player.move(dir)`. `turn` should call `Player.rotate(90)`."
        },
        {
          "level": 3,
          "kind": "concept",
          "md": "Call `cmds.go(\"east\")` three times, then `cmds.turn()`."
        },
        {
          "level": 4,
          "kind": "assist",
          "md": "const cmds = {\n  go(dir) { Player.move(dir) },\n  turn() { Player.rotate(90) }\n}\ncmds.go(\"east\"); cmds.go(\"east\"); cmds.go(\"east\"); cmds.turn()\nmodule.exports = { cmds }"
        }
      ],
