      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "Do not use `text.length` — that counts UTF-16 code units, not UTF-8 bytes."
        },
        {
          "level": 2,
          "kind": "concept",
          "md": "`Buffer.byteLength(text, \"utf8\")` is the disk size of the string."
        },
        {
          "level": 3,
          "kind": "concept",
          "md": "Buffer.byteLength(text, \"utf8\")"
        },
        {
          "level": 4,
          "kind": "assist",
          "md": "function bytesOf(text) { return Buffer.byteLength(text, \"utf8\") }\nconsole.log(bytesOf(\"café\"))\nmodule.exports = { bytesOf }"
        }
      ]
    }
  ],
  "description": "Bytes are not the same as text. Decode them on purpose."
