      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "Beacon is at x=3, y=2. One move changes one coordinate by 1. Trees and rocks block; walk around them."
        },
        {
          "level": 2,
          "kind": "concept",
          "md": "You need three east calls and two south calls. Order does not matter. The coin on the way is optional."
        },
        {
          "level": 3,
          "kind": "concept",
          "md": "east increases x. south increases y. The owl is scenery."
        },
        {
          "level": 4,
          "kind": "assist",
          "md": "Player.move(\"east\")\nPlayer.move(\"east\")\nPlayer.move(\"east\")\nPlayer.move(\"south\")\nPlayer.move(\"south\")"
        }
