        {
          "type": "js-assert"
        }
      ],
      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "Beacon is at x=3, y=2. One move changes one coordinate by 1."
        },
        {
          "level": 2,
          "kind": "concept",
          "md": "You need three east calls and two south calls. Order does not matter."
        },
        {
          "level": 4,
          "kind": "assist",
          "md": "Player.move(\"east\") three times, then Player.move(\"south\") twice."
        }
