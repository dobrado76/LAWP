        {
          "level": 4,
          "kind": "assist",
          "md": "function walk(steps, fn) {\n  for (let i = 0; i < steps; i++) fn()\n}\nwalk(3, () => Player.move(\"east\"))\nmodule.exports = { walk }"
        }
