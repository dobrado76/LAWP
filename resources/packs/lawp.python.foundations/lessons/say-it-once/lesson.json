  "blocks": [
    {
      "type": "explain",
      "md": "## Print is a tool\n\nThe program is the greeting. `print` is how you show it. Use the `name` value so changing the name changes the line."
    },
    {
      "type": "code",
      "id": "f-hello",
      "engine": "python",
      "entry": "main.py",
      "files": [
        {
          "path": "files/main.py",
          "role": "edit"
        }
      ],
      "checks": [
        {
          "type": "stdout",
          "equals": "Hello, Ada!",
          "misconceptionId": "print-is-the-program"
        },
        {
          "type": "ast",
          "query": "name"
        }
      ],
      "hintLadder": [
        {
          "level": 1,
          "kind": "concept",
          "md": "The output must include the name Ada from the variable."
        },
        {
          "level": 2,
          "kind": "concept",
          "md": "print(f\"Hello, {name}!\")"
        }
      ]
    }
  ],
  "description": "Write a message once and reuse it instead of repeating yourself."
}
